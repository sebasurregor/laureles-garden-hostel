# Copia este archivo como .env (Copy-Item .env.example .env) y ajusta los valores.
# NUNCA subas .env a git ni lo compartas por WhatsApp o correo.

# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/NOMBRE_BASE
# Si la contraseña tiene caracteres especiales, codifícalos: @ -> %40, # -> %23, / -> %2F, : -> %3A
DATABASE_URL=postgresql://postgres:CAMBIAR_contrasena@localhost:5432/laureles_garden

# Base de datos SOLO para las pruebas automáticas (pytest). Se borra en cada prueba:
# debe ser una base distinta y su nombre debe contener "test" o "prueba".
TEST_DATABASE_URL=postgresql://postgres:CAMBIAR_contrasena@localhost:5432/laureles_garden_test

# Claves: no las escribas a mano. Ejecuta:  py scripts\generar_claves.py
SECRET_KEY=CAMBIAR
FERNET_KEY=CAMBIAR
HMAC_KEY=CAMBIAR

# Modo de depuración: siempre 0 en el hostal y en producción.
FLASK_DEBUG=0

# Nombre y versión mostrados en la aplicación (HU-09).
NOMBRE_HOSTAL=Laureles Garden Hostel
APP_VERSION=2.0.0
ENTORNO=desarrollo

# Seguridad y despliegue en producción (HU-07 y HU-09):
# - En local (HTTP): FORZAR_HTTPS=0, CONFIAR_PROXY=0
# - En producción detrás de HTTPS (Render, Railway, Nginx/Caddy): FORZAR_HTTPS=1, CONFIAR_PROXY=1
# - SOLO_LOCAL=1 restringe la app a 127.0.0.1; déjalo en 0 cuando uses login en red o producción.
FORZAR_HTTPS=0
CONFIAR_PROXY=0
SOLO_LOCAL=0

# Optimización de conexiones a PostgreSQL (HU-10)
USAR_POOL_CONEXIONES=1
DB_POOL_MIN=2
DB_POOL_MAX=10

# Servidor local Windows (servir.py)
HOST=127.0.0.1
PUERTO=8000
HILOS=16
